{
  "name": "n8n-nodes-dwolla",
  "version": "1.0.0",
  "description": "n8n community node for Dwolla ACH payment platform - enables workflow automation for ACH transfers, customer management, funding sources, mass payments, and white-label payment operations",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "dwolla",
    "ach",
    "payments",
    "bank-transfer",
    "fintech",
    "money-transfer",
    "same-day-ach",
    "rtp",
    "white-label",
    "mass-payments"
  ],
  "license": "BUSL-1.1",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-dwolla.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-dwolla#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-dwolla/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist"
  },
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "README_LICENSING.md",
    "LICENSING_FAQ.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DwollaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Dwolla/Dwolla.node.js",
      "dist/nodes/Dwolla/DwollaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
